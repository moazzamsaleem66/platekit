<?xml version="1.0" encoding="utf-8"?>
<!-- Maroon country-code badge at the start of the plate preview row. Presentation-only;
     color is the current default country's accent (Qatar maroon) — override via
     PlateInputView's badge color API for a different default country. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/platekit_qatar_plate_maroon" />
    <corners
        android:topLeftRadius="10dp"
        android:bottomLeftRadius="10dp"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
