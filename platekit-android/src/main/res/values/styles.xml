<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained text/field styles for platekit-android. These use system fonts
  (sans-serif-medium / sans-serif-medium bold) rather than the host app's custom
  font family, since a library can't reference resources owned by the app that
  depends on it. Visually close, not pixel-identical, to the original app styling.
-->
<resources>
    <style name="Platekit.TextAppearance.Medium" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Platekit.TextAppearance.MediumBold" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Platekit.FieldLabel" parent="Platekit.TextAppearance.MediumBold">
        <item name="android:textColor">@color/platekit_text_navy_900</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Platekit.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeColor">@color/platekit_input_border</item>
        <item name="hintEnabled">false</item>
        <item name="android:textColorHint">@color/platekit_text_hint_grey</item>
        <item name="startIconTint">@color/platekit_text_slate_600</item>
        <item name="endIconTint">@color/platekit_text_slate_600</item>
        <item name="android:layout_height">44dp</item>
    </style>

    <style name="Platekit.FieldInput" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
